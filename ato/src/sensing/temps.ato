    power_3v3.hv ~ st4.p1
    # GND
    GND ~ c76.p2
    GND ~ c77.p2
    GND ~ c78.p2
    GND ~ r128.p2
    GND ~ r129.p2
    GND ~ r130.p2
    # TMPHS1
    TMPHS1 ~ c78.p1
    TMPHS1 ~ r128.p1
    TMPHS1 ~ st1.p2
    # TMPHS2
    TMPHS2 ~ c77.p1
    TMPHS2 ~ r129.p1
