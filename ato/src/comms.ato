    CANL ~ u55.CANL
    # CAN_RX
    CAN_RX ~ u55.R
    # CAN_TX
    CAN_TX ~ u55.D
    # GND
    GND ~ c26.p2
    GND ~ d17.p3
    GND ~ j2.Pin_1
    GND ~ u55.GND
    GND ~ u55.Rs
    # Net-(JP1-A)
    jp1.A ~ r26.p1

    # designators (identical to the KiCad design)
