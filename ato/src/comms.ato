module CanBus:
    """Schematic block: CAN BUS
    6 parts: C26, D17, J2, JP1, R26, U55
    """

    c26 = new v100nF_C_0805_2012Metric
    d17 = new ESDCAN01_2BLY_SOT95P255X150_3N
    j2 = new CAN_MON_PinHeader_1x03_P2_54mm_Vertical
    jp1 = new SolderJumper_2_Open_SolderJumper_2_P1_3mm_Open_Pad1_0x1_5mm
