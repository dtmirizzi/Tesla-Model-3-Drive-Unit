    signal CANL
    signal CAN_RX
    signal CAN_TX
    signal GND

    # +3V3
    power_3v3.hv ~ c26.p1
    power_3v3.hv ~ u55.VCC
    # /CANH
    CANH ~ d17.p1
    CANH ~ j2.Pin_3
    CANH ~ jp1.B
